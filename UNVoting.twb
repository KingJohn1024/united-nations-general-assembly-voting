          </datasources>
          <datasource-dependencies datasource='federated.1gr10jb0j3o66z10jaa3g0bg7gmw'>
            <column caption='Info' datatype='string' name='[Calculation_538743121764569088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;i&quot;' />
            </column>
            <column-instance column='[Calculation_538743121764569088]' derivation='None' name='[none:Calculation_538743121764569088:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
