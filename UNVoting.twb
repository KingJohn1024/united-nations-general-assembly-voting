            <column caption='Top Level Description' datatype='string' name='[TopLevelDescription]' role='dimension' type='nominal' />
            <column-instance column='[ActionDate]' derivation='None' name='[none:ActionDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CoincidenceCountryName]' derivation='None' name='[none:CoincidenceCountryName:nk]' pivot='key' type='nominal' />
