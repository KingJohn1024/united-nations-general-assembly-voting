    <worksheet name='IVC BY Category'>
      <table>
        <view>
          <datasources>
            <datasource caption='UNVoting Hyper Extract' name='federated.1gr10jb0j3o66z10jaa3g0bg7gmw' />
          </datasources>
          <datasource-dependencies datasource='federated.1gr10jb0j3o66z10jaa3g0bg7gmw'>
            <column caption='Action Date' datatype='datetime' name='[ActionDate]' role='dimension' type='ordinal' />
            <column caption='n_a' datatype='integer' name='[Calculation_4111293902586175494 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [VotingBloc], [ID (VoteDetails)], [ActionDate]:sum(&#10;IF [Vote] = &quot;A&quot;&#10;THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='n_n' datatype='integer' name='[Calculation_4111293902586175494 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [VotingBloc], [ID (VoteDetails)], [ActionDate]:sum(&#10;IF [Vote] = &quot;N&quot;&#10;THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='IVC' datatype='real' name='[Calculation_4111293902586175494 2 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(2 * (([Calculation_4111293902586175494]-1) * [Calculation_4111293902586175494] + ([Calculation_4111293902586175494 1]-1) * [Calculation_4111293902586175494 1] + ([Calculation_4111293902586175494 1 1]-1) * [Calculation_4111293902586175494 1 1] + [Calculation_4111293902586175494 1 1] * ([Calculation_4111293902586175494]+[Calculation_4111293902586175494 1]) - ([Calculation_4111293902586175494 2]^2/2)+[Calculation_4111293902586175494 2])) / [Calculation_4111293902586175494 2]^2' />
            </column>
            <column caption='N' datatype='integer' name='[Calculation_4111293902586175494 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4111293902586175494] + [Calculation_4111293902586175494 1] + [Calculation_4111293902586175494 1 1]' />
