            <column caption='Top Level Description' datatype='string' name='[TopLevelDescription]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_538743121764569088]' derivation='None' name='[none:Calculation_538743121764569088:nk]' pivot='key' type='nominal' />
            <column-instance column='[SubLevelDescription]' derivation='None' name='[none:SubLevelDescription:nk]' pivot='key' type='nominal' />
            <column-instance column='[TopLevelDescription]' derivation='None' name='[none:TopLevelDescription:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1gr10jb0j3o66z10jaa3g0bg7gmw].[Action (Country Code)]</column>
            <column>[federated.1gr10jb0j3o66z10jaa3g0bg7gmw].[none:SubLevelDescription:nk]</column>
