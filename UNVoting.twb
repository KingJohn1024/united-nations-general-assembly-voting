            <column-instance column='[TopLevelDescription]' derivation='None' name='[none:TopLevelDescription:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_510736374122119172]' derivation='User' name='[usr:Calculation_510736374122119172:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ActionDate]' derivation='Year' name='[yr:ActionDate:ok]' pivot='key' type='ordinal' />
